# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会被提交。

# ── 必填 ──
# API key。DeepSeek 用 sk-xxx，Anthropic 用 sk-ant-xxx
LLM_API_KEY=your-api-key-here

# ── 可选 ──
# Provider 类型：openai（DeepSeek/GLM/Kimi/智谱…）或 anthropic（Claude API/中转站）
# 不设置默认走 openai（兼容面最广）
# LLM_PROVIDER=openai

# API 端点。DeepSeek 官方：https://api.deepseek.com
# 第三方中转站填自己的地址
# LLM_BASE_URL=https://api.deepseek.com

# 模型名。DeepSeek：deepseek-chat / deepseek-v4-pro / deepseek-reasoner
# LLM_MODEL=deepseek-chat

# DeepSeek 推理模型默认开启 thinking（reasoning_content）。
# 设为 disabled 关闭思考模式，避免 tool use 时需回传 reasoning_content 的报错。
# LLM_THINKING=disabled
